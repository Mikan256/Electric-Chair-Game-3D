{
  "name": "electric-chair-game-3d",
  "version": "0.1.0",
  "private": true,
  "description": "水曜日のダウンタウン「電気イスゲーム」を three.js + TypeScript で作る Flaxia Arcade 向け 3D マルチプレイゲーム",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:harness": "vite --open /dev/harness.html",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "assets:sync": "node scripts/sync-assets.mjs",
    "assets:optimize": "python3 scripts/optimize-assets.py",
    "assets:manifest": "node scripts/sync-assets.mjs --manifest-only",
    "simulate": "tsx scripts/simulate.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "assets:compress": "bash scripts/compress-media.sh",
    "assets:voice": "bash scripts/generate-round-voice.sh",
    "validate:zip": "python3 scripts/validate-flaxia-zip.py",
    "release:flaxia": "node scripts/package-flaxia.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^16.4.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
